root = true

[*]
charset = utf-8
end_of_line = lf
ij_continuation_indent_size = 4
insert_final_newline = true
indent_style = space
indent_size = 2
max_line_length = 120
tab_width = 4

[*.java]
ij_continuation_indent_size = 4
ij_java_class_count_to_use_import_on_demand = 500
ij_java_names_count_to_use_import_on_demand = 300
ij_java_packages_to_use_import_on_demand =
ij_java_use_single_class_imports = true
indent_style = space
indent_size = 4

[*.xml]
indent_style = space
indent_size = 2

[*.properties]
indent_style = space
indent_size = 2

[*.md]
indent_style = space
indent_size = 4
trim_trailing_whitespace = false

[*.html]
indent_style = space
indent_size = 2

[*.{js,ts,jsx,tsx}]
indent_style = space
indent_size = 2

[*.json]
indent_style = space
indent_size = 2

[*.yaml]
indent_style = space
indent_size = 2
